<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)..\Common\RMIStdPropsRelease.props" />
    <Import Project="$(SolutionDir)..\RMIDll\RMIBase\prg\UseRMIBaseDll.props" />
    <Import Project="$(SolutionDir)..\RMIDll\RMIMyDB\prg\UseRMIMyDBDll.props" />
  </ImportGroup>
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <_PropertySheetDisplayName>MandatoryFields Release</_PropertySheetDisplayName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>MANDATORYFIELDS_API=__declspec(dllexport);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>Include;PrivateInclude;Source;Resource;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link />
  </ItemDefinitionGroup>
</Project>