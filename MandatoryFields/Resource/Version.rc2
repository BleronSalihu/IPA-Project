/////////////////////////////////////////////////////////////////////////////
//
// Includes
//
#include "MandatoryFieldsVersion.h"


/////////////////////////////////////////////////////////////////////////////
//
// Defines
//
#define VERSINFO_FILEVERSION        VERSINFO_MANDATORYFIELDS_MAJOR,VERSINFO_MANDATORYFIELDS_MAJOR_REV,VERSINFO_MANDATORYFIELDS_MINOR,VERSINFO_MANDATORYFIELDS_MINOR_REV
#define VERSINFO_PRODUCTVERSION     VERSINFO_FILEVERSION
#define VERSINFO_FILEOS             VOS_NT_WINDOWS32
#define VERSINFO_FILETYPE           VFT_DLL
#define VERSINFO_FILESUBTYPE        VFT2_UNKNOWN
#define VERSINFO_FILEFLAGSMASK      0x003FL
#ifdef _DEBUG
    #define VERSINFO_FILEFLAGS      VS_FF_DEBUG|VS_FF_PRERELEASE
#else
    #define VERSINFO_FILEFLAGS      0x0000L
#endif

#define VERSINFO_MANDATORYFIELDS_FILEVERSION_STR    VERSINFO_MANDATORYFIELDS_MAJOR_STR "." VERSINFO_MANDATORYFIELDS_MAJOR_REV_STR "." VERSINFO_MANDATORYFIELDS_MINOR_STR ", " VERSINFO_MANDATORYFIELDS_MINOR_REV_STR "\0"
#define VERSINFO_MANDATORYFIELDS_PRODUCTVERSION_STR VERSINFO_MANDATORYFIELDS_MAJOR_STR "." VERSINFO_MANDATORYFIELDS_MAJOR_REV_ALIAS "." VERSINFO_MANDATORYFIELDS_MINOR_STR ", (" PROGRAM_VERSION_INTERNALNAME ")\0"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VERSINFO_FILEVERSION
 PRODUCTVERSION VERSINFO_PRODUCTVERSION
 FILEFLAGSMASK  VERSINFO_FILEFLAGSMASK
 FILEFLAGS      VERSINFO_FILEFLAGS
 FILEOS         VERSINFO_FILEOS
 FILETYPE       VERSINFO_FILETYPE
 FILESUBTYPE    VERSINFO_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "Comments",           VERSINFO_MANDATORYFIELDS_COMMENTS
            VALUE "CompanyName",        VERSINFO_COMPANYNAME
            VALUE "FileDescription",    VERSINFO_MANDATORYFIELDS_FILEDESCRIPTION
            VALUE "FileVersion",        VERSINFO_MANDATORYFIELDS_FILEVERSION_STR
            VALUE "InternalName",       VERSINFO_MANDATORYFIELDS_INTERNALNAME
            VALUE "LegalCopyright",     VERSINFO_LEGALCOPYRIGHT
            VALUE "OriginalFilename",   VERSINFO_MANDATORYFIELDS_ORIGINALFILENAME
            VALUE "ProductName",        VERSINFO_MANDATORYFIELDS_PRODUCTNAME
            VALUE "ProductVersion",     VERSINFO_MANDATORYFIELDS_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
